# PEAR-TREE rust discovery config for real human WGS (pass with `--config`).
#
# Validated on the 10k/10k full-stack harness (test/fullstack/scale10k): with these
# settings discovery + combine yield 0 genuine false positives at 95.4% recall.
# coverage_mask is the key change vs the defaults — see README.md.

min_mapq = 60                    # human WGS floor (config_hs); centromeric mismaps stay MAPQ<60

# SPEC-3 pileup gate: drop breakpoints whose local depth exceeds N x the genome-wide
# median. Removes classical-satellite / pericentromere mismap pileups (the reads stack
# to tens of x median at MAPQ 60, so neither the MAPQ floor nor the combine remap
# catches them). True insertions sit at ~1x median, so recall is unchanged.
coverage_mask = true
coverage_mask_multiplier = 5.0

# adaptive_evidence (SPEC-4) also cuts these FPs but scales the evidence floor by local
# coverage and loses low-VAF true insertions -> leave OFF (coverage_mask is the clean fix).
adaptive_evidence = false
