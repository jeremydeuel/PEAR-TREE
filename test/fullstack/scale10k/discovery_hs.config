# PEAR-TREE rust discovery config for real human WGS (pass with `--config`).
#
# Validated on the 10k/10k full-stack harness (test/fullstack/scale10k). With these
# settings discovery + combine yield 97.2% recall at 0 genuine false positives. History:
#   coverage_mask + min_mapq 40 + mate_anchor_rescue    -> 96.0% (baseline sensitivity)
#   + two-pointer pairing fix (discovery.rs output())   -> 96.3%
#   + discordant one-sided anchoring (block below)      -> 97.2% (+96 TP), still 0 FP
# The sweep (README.md) showed this is the best recall reachable without combine
# re-introducing any FP.

# --- specificity ---------------------------------------------------------------
# SPEC-3 pileup gate: drop breakpoints whose local depth exceeds N x the genome-wide
# median. Removes classical-satellite / pericentromere mismap pileups (reads stack to
# tens of x median at MAPQ 60, so neither the MAPQ floor nor the combine remap catches
# them). True insertions sit at ~1x median -> recall unchanged. This is what takes the
# residual combine FP to 0; keep it ON.
coverage_mask = true
coverage_mask_multiplier = 5.0

# --- sensitivity ---------------------------------------------------------------
# min_mapq 40 (not the 60 human default): with coverage_mask + mate rescue the extra
# low-MAPQ candidates it admits are all cleaned by combine's remap, and it buys ~0.7%
# recall over 60. The sweep confirmed 0 genuine FP after combine at this floor.
min_mapq = 40

# mate_anchor_rescue: accept a soft-clipped read below min_mapq when its mate maps
# uniquely (MQ tag >= min_mapq). Recovers insertions into low-mapability-but-mate-unique
# flanks -- the ENTIRE residual miss population on this harness (esp. L1: 92.8 -> 96.9%
# at discovery). +62 true insertions post-combine, 0 added FP. Needs the MQ tag from
# `samtools fixmate` (present after the standard fixmate/sort/markdup pipeline).
mate_anchor_rescue = true

# --- discordant one-sided anchoring (Feature A) --------------------------------
# The dominant residual misses are young-element insertions where only ONE junction
# clip clusters a breakpoint (the reciprocal clip maps to reference paralogs / below
# MAPQ, so it never clusters). Discordant anchoring pairs such a lone breakpoint with a
# cluster of discordant read-pairs (flank-anchored reads whose mate fell into the
# inserted element) supplying the missing side. Emits a `disc_<pos>` end; combine routes
# the one real side through its clean-remap / clipped-remap filters like a poly-A call.
# End-to-end on this harness: +96 true insertions (biggest gain on Alu: 96.0 -> 97.5%),
# 0 added FP. Off by default in the binary; enabled here.
discordant_anchor = true
discordant_min_reads = 3          # >= this many discordant pairs to form a cluster
discordant_window = 50            # cluster width for discordant observations (bp)
discordant_max_tlen = 1000        # same-contig template length beyond which a pair is discordant
discordant_rescue_span = 300      # search this far (bp) from the lone breakpoint to the cluster
                                  # (discordant anchors sit ~a fragment-length out, not within the TSD)
# Specificity gates for these weaker one-sided calls (each tuned to add 0 FP on the
# harness while keeping the recovered TPs). Without them, one-sided anchoring surfaces
# ~2 organic assembly-discordance FPs per 10k that two-sided calling avoided:
discordant_coverage_max_mult = 3.0   # tighter pileup ceiling than the 5x global mask (kills a
                                     # ~2.6x-median subtelomeric pileup FP; real TPs sit <= 1.6x)
discordant_mate_min_kmer_div = 0.5   # reject calls whose mate reads are a low-diversity satellite
                                     # array (HSat); a real MEI's flank-anchored mates are complex.
                                     # Gates the mates, NOT the clip, so real poly-A/SVA-VNTR clips
                                     # (legitimately low-complexity) are spared.
# (A flank low-complexity gate — reject a lone breakpoint whose genomic flank is itself a
#  satellite array — is always applied to discordant calls in the binary; no knob.)

# Toggles that did NOT help here (our misses are mappability-limited, not these), left
# OFF to avoid needless FP surface:
#   evidence_window / short_polya_clip / consensus_tolerant  -> +0.0-0.1% recall, +FP
#   adaptive_evidence (SPEC-4)                               -> removes FP but loses ~45 low-VAF TPs
#   max_lowq_clip_ratio guard (SENS-2)                       -> DROPS the mate-rescued loci; do not pair with rescue
#   min_evidence_reads_per_breakpoint = 1                    -> +0.1% recall, +32 FP; keep at 2
