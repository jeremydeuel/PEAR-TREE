# ISOLATED A/B: config.discovery.grch38 with ONLY the SPEC-8 mapped-side slippage gate OFF.
#
# PURPOSE. The full config.discovery.grch38 (all 5 features on) was compared against the old
# config.discovery.grch38.noslip contract (insertions_grch38, all slippage OFF, and predating
# discordant/coverage/mate). On the frozen 9x10 truth set (analysis/mei9x10/frozen_truth.tsv,
# label_v2) that comparison showed a 30.1% germline-TP DROP (1018/3381), with:
#   - coverage_mask EXONERATED  (0/1018 dropped TP have cov_max>=180),
#   - SPEC-8b clip gate ~BASELINE (28.5% of dropped TP vs 24.5% of kept -> not the driver),
#   - SPEC-8 slippage_filter the prime suspect by elimination (it keys on a reference poly-A
#     run at the breakpoint = the L1-endonuclease target site where real Alu/L1 land).
# The frozen table has no reference-side column, so that attribution is circumstantial. This
# file isolates it: diff against config.discovery.grch38 and the ONLY line that differs is
#     slippage_filter = true  ->  slippage_filter = false
# clip_slippage_filter (SPEC-8b) STAYS ON -- it is the validated gate (0.45% TP loss). If
# slippage_filter is the culprit, a rerun with this config should collapse the dropped-TP set
# from ~1000 back to ~15 (the SPEC-8b-only expectation), at a modest FP-recovery cost.
#
# Regenerate rather than hand-edit if the parent config changes:
#     sed 's/^slippage_filter = true/slippage_filter = false/' \
#         cluster/config.discovery.grch38 > cluster/config.discovery.grch38.noSPEC8
#
# ---- original config.discovery.grch38 header follows ----
# PEAR-TREE Rust discovery config for GRCh38 BAMs (Sanger canpipe output).
#
# For the 9x10 blood/HSPC benchmark cohort: bwa-mem mapped to
# GRCh38_full_analysis_set_plus_decoy_hla (AS reads "NCBI38", NOT "GRCh38"), 3,366 contigs,
# total reference length 3,217,346,917, chr1 LN 248,956,422.
#
# Discovery itself is assembly-agnostic. Only two things matter here:
#   - min_mapq 60: bwa-mem caps MAPQ at 60; 60 keeps uniquely-placed reads only.
#   - contig_allowlist: process the primary assembly and nothing else.
#
# *** THE ALLOWLIST IS THE WHOLE POINT OF THIS FILE. *** GRCh38 names contigs chr1..chrY;
# GRCh37/hs37d5 names them 1..Y. Running config.discovery.grch37 against these BAMs matches
# ZERO contigs and yields an EMPTY discovery file per colony -- with no error, because "no
# reads on the allowlisted contigs" is indistinguishable from "no evidence found". 90 empty
# files that look like a clean run is exactly the failure mode this cohort exists to avoid.
# Check the allowlist against the BAM's @SQ names before every new cohort.
#
# The allowlist also drops, by omission: chrM (circular, high coverage), the ~2,800 alt/HLA
# contigs, chrUn_*/random decoys, and chrEBV. Alts matter more on GRCh38 than the hs37d5
# decoys did -- a read pair spanning an alt and its primary looks like a structural junction.
#
# key = value, '#' starts a comment.

min_mapq = 60
contig_allowlist = chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY

# Feature B -- processed-pseudogene (splice) annotation. ON by default (matches the grch37
# config). It is non-gating (it only writes a per-colony <out>.splice.tsv; the breakpoint
# output is unchanged), and exon_annotation MUST match the BAM assembly AND contig naming.
# The GRCh38 exon model below is Ensembl GRCh38 (chr-prefixed, protein_coding + lncRNA,
# per-gene merged exons, contig/begin/end/gene, 0-based half-open), built with
# tools/build_grch38_exon_track.py and staged to the path below. It is REQUIRED when
# splice_hallmark is on: the discovery binary exits(1) if it is missing or unreadable
# (see main.rs D5), so a wrong/absent track fails loudly rather than silently annotating
# nothing -- which is why this can be a safe default. This supersedes the old
# config.discovery.grch38.splice variant (now identical to this file).
splice_hallmark = true
exon_annotation = /lustre/scratch126/casm/teams/team273/users/jd43/grch38.exons.bed.gz
splice_min_exons = 2

# SPEC-8 -- homopolymer-slippage gate. *** OFF IN THIS A/B ARM *** (the whole point of this
# file). In config.discovery.grch38 this is `true`; here it is `false` so the arm isolates its
# recall cost. See config.discovery.grch37 for the full rationale and the measured recall
# table; the mechanism is reference-sequence-local. Its shipped numbers were measured on
# PD44579 hs37d5 against 1kG MEIs and do NOT transfer to GRCh38 -- which is exactly what this
# arm is here to quantify (candidate cause of the 30% 9x10 TP drop).
slippage_filter = false
slippage_min_ref_run = 8      # >= 8 stays clear of the 4 bp TTTT/AA L1-endonuclease motif
slippage_min_clip_frac = 0.6  # the only real lever: 0.6 -> 41% of band, 0.9 -> 9% (on hs37d5)
slippage_max_period = 6       # 1 = poly-A only; <=6 also allows (CA)n/(TG)n/(TAAAA)n

# SPEC-8b -- bilateral clip-consensus homopolymer/entropy slippage gate (distinct from SPEC-8:
# it inspects the two breakpoint CLIP consensuses, not the aligned side). Rejects a paired
# insertion only when BOTH clips are homopolymer + low-entropy; a real MEI keeps a structured
# element body on one side, so one-sidedness spares it. KEPT ON in this arm -- it is the
# validated gate. Validated on analysis/mei9x10: 64.3% of phylogeny-breaking FP at 0.45%
# germline-TP loss. See analysis/mei9x10/SPEC8b_operating_point.md.
clip_slippage_filter = true
clip_slippage_min_run = 11
clip_slippage_max_entropy = 1.95
clip_slippage_any_base = true  # count poly-A/C/G/T runs (+243 poly-C/G FP at 0 extra TP loss)

# SPEC-3 coverage mask + Feature A discordant anchoring + mate-anchor rescue.
# Enabled 2026-07-18 to bring this config to the full validated feature set. These were
# previously left at their default-OFF, so any 9x10 run predating this date did NOT have
# them -- a rerun with these on is therefore NOT comparable to the slippage-only baseline.
# Values are the operating point validated in test/fullstack/scale10k/discovery_hs.config.
#   coverage_mask (SPEC-3)     drop breakpoints whose local coverage exceeds 5x the local
#                              median; kills pericentromeric satellite FP at ~0 recall loss.
#   discordant_anchor (Feat A) one-sided discordant discovery: +96 TP at 0 FP on benchmark.
#                              Runs without an RTE track (discordant_rte_only stays false).
#                              The three gates that hold FP at 0 are coverage_max_mult,
#                              mate_min_kmer_div, and min_reads below.
#   mate_anchor_rescue         recover a breakpoint from a well-anchored mate.
coverage_mask = true
coverage_mask_multiplier = 5.0
mate_anchor_rescue = true
discordant_anchor = true
discordant_min_reads = 3
discordant_window = 50
discordant_max_tlen = 1000
discordant_rescue_span = 300
discordant_coverage_max_mult = 3.0
discordant_mate_min_kmer_div = 0.5
