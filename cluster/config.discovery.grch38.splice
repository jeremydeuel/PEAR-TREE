# PEAR-TREE Rust discovery config for GRCh38 BAMs -- SPLICE VARIANT of config.discovery.grch38.
#
# Identical to config.discovery.grch38 EXCEPT Feature B (processed-pseudogene splice
# annotation) is ON. Feature B is NON-GATING: it only writes a per-colony <out>.splice.tsv;
# the breakpoint output (the .txt.gz that becomes the genotyping contract) is byte-for-byte
# what the base config produces. So a discovery re-run with this config does NOT change which
# insertions are found or the contract -- it only adds the splice sidecars that
# combine_insertions re-keys into <stem>.combined.splice.tsv for annotate_v2's
# processed-pseudogene calls. Existing genotypes stay valid; no re-genotyping.
#
# exon_annotation MUST match the BAM assembly AND contig naming. This points at the
# GRCh38 exon track built from Ensembl GRCh38.112 (protein_coding + lncRNA, per-gene merged
# exons, chr-prefixed chr1..chrY, `contig begin end gene`, 0-based half-open). Build it with
# tools/build_grch38_exon_track.py and stage it to the path below before submitting.
#
# key = value, '#' starts a comment.

min_mapq = 60
contig_allowlist = chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY

# Feature B -- processed-pseudogene (splice) annotation. ON for this variant.
splice_hallmark = true
exon_annotation = /lustre/scratch126/casm/teams/team273/users/jd43/grch38.exons.bed.gz
splice_min_exons = 2

# SPEC-8 -- homopolymer-slippage gate. Kept identical to config.discovery.grch38 so the
# breakpoint set (and thus the contract) is unchanged; see that file for the full rationale.
slippage_filter = true
slippage_min_ref_run = 8
slippage_min_clip_frac = 0.6
slippage_max_period = 6

# SPEC-8b -- bilateral clip-consensus slippage gate. Kept identical to config.discovery.grch38
# so the breakpoint set is unchanged. Shipped default; see that file / SPEC8b_operating_point.md.
clip_slippage_filter = true
clip_slippage_min_run = 11
clip_slippage_max_entropy = 1.95
clip_slippage_any_base = true
